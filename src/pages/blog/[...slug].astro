---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

// 静的ジェネレート用のパス生成
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const pubDate =
  post.data.pubDate instanceof Date
    ? post.data.pubDate
    : new Date(post.data.pubDate);
---

<Layout title={post.data.title}>
  <div class="max-w-4xl mx-auto px-6 py-12 md:py-20">
    <!-- 戻るボタン (インダストリアルスタイル) -->
    <a
      href="/blog"
      class="inline-flex items-center gap-2 border-[3px] border-[#202836] bg-white px-5 py-2.5 text-xs font-black tracking-widest text-[#202836] hover:bg-[#EFEAE2] hover:text-[#D60000] transition-colors duration-300 mb-8 uppercase"
    >
      <span class="text-[#D60000]">➔</span> blog一覧に戻る
    </a>

    <!-- 本文コンテナ -->
    <article
      class="border-[3px] border-[#202836] bg-white p-6 md:p-16 relative"
    >
      <!-- 最上部の装飾的な赤いライン -->
      <div class="absolute left-0 right-0 top-0 h-1.5 bg-[#D60000]"></div>

      <!-- メタ情報 -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 bg-[#D60000] rounded-full"></span>
          <time class="text-sm font-bold code-font text-[#202836]">
            {
              pubDate
                .toLocaleDateString("ja-JP", {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                })
                .replace(/\//g, ".")
            }
          </time>
        </div>

        <div class="flex flex-wrap gap-1.5">
          {
            post.data.tags?.map((tag: string) => (
              <span class="text-[10px] font-['Fira_Code'] font-bold text-[#202836] border border-[#202836] px-2 py-0.5 uppercase tracking-wider bg-white">
                {tag}
              </span>
            ))
          }
        </div>
      </div>

      <!-- タイトル -->
      <h1
        class="text-3xl md:text-5xl font-black text-[#202836] leading-tight mb-6"
      >
        {post.data.title}
      </h1>

      <!-- 概要 -->
      <p
        class="text-sm md:text-base text-[#4A5568] bg-[#F5F2EB] border-l-4 border-[#D60000] p-4 mb-10 font-medium leading-relaxed"
      >
        {post.data.description}
      </p>

      <!-- 本文 (Markdown レンダリング領域) -->
      <div class="markdown-content text-[#202836]">
        <Content />
      </div>
    </article>
  </div>
</Layout>

<style is:global>
  /* Markdown本文のインダストリアル・ソリッドスタイル */
  .code-font {
    font-family: "Fira Code", monospace;
  }

  .markdown-content {
    line-height: 1.8;
    font-size: 1rem;
  }

  .markdown-content h1,
  .markdown-content h2,
  .markdown-content h3,
  .markdown-content h4 {
    color: #202836;
    font-weight: 900;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    line-height: 1.4;
  }

  .markdown-content h1 {
    font-size: 1.8rem;
    border-bottom: 3px solid #202836;
    padding-bottom: 0.5rem;
  }

  .markdown-content h2 {
    font-size: 1.5rem;
    border-bottom: 2px solid #202836;
    padding-bottom: 0.5rem;
  }

  .markdown-content h3 {
    font-size: 1.25rem;
    padding-left: 0.5rem;
    border-left: 3px solid #d60000;
  }

  .markdown-content p {
    margin-bottom: 1.5rem;
  }

  .markdown-content ul,
  .markdown-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .markdown-content ul {
    list-style-type: square;
  }

  .markdown-content ol {
    list-style-type: decimal;
  }

  .markdown-content li {
    margin-bottom: 0.5rem;
  }

  .markdown-content a {
    color: #d60000;
    text-decoration: underline;
    font-weight: 700;
    text-underline-offset: 4px;
  }

  .markdown-content a:hover {
    color: #990000;
  }

  /* インラインコード */
  .markdown-content :not(pre) > code {
    font-family: "Fira Code", monospace;
    font-weight: 600;
    background-color: #f5f2eb;
    color: #d60000;
    padding: 0.2rem 0.4rem;
    border: 1px solid #202836;
    border-radius: 2px;
    font-size: 0.875rem;
  }

  /* コードブロック */
  .markdown-content pre {
    background-color: #202836 !important;
    padding: 1.5rem;
    border: 2px solid #202836;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    overflow-x: auto;
  }

  .markdown-content pre code {
    font-family: "Fira Code", monospace;
    font-size: 0.9rem;
    background-color: transparent !important;
    padding: 0;
    border: none;
    color: #efeae2 !important;
  }

  /* 引用 */
  .markdown-content blockquote {
    border-left: 4px solid #202836;
    padding-left: 1rem;
    color: #4a5568;
    font-style: italic;
    margin: 1.5rem 0;
  }
</style>
