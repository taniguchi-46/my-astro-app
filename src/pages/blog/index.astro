---
import Layout from "../../layouts/Layout.astro";
import Article from "../../components/Article.astro";
import AllPosts from "../../components/AllPosts.astro";
import PageHeader from "../../components/PageHeader.astro";
---

<Layout title="BLOG ARCHIVES">
  <PageHeader
    tag="SYSTEM NODE: ARCHIVES"
    tagPulse={false}
    title="BLOG"
    titleHighlight="ARCHIVES."
    breakLine={true}
    maxWidthClass="max-w-7xl"
    paddingClass="py-20 md:py-28"
    headingSizeClass="text-5xl md:text-8xl"
    descriptionClass="mt-8 max-w-xl text-sm md:text-base"
    tagSpacingClass="mb-6"
    dotSizeClass="w-3.5 h-3.5"
  />

  {/* NEW POSTS セクション (スライダー) */}
  <section
    class="max-w-7xl mx-auto px-6 py-12 md:py-16 border-b-[3px] border-[#202836]"
  >
    <Article />
  </section>

  {/* ALL POSTS セクション (縦並び) */}
  <section class="max-w-7xl mx-auto px-6 py-16 md:py-24">
    <AllPosts />
  </section>
</Layout>
