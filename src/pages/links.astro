---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Card from "../components/Card.astro";

// =============================================================================
// LINKS PAGE — 次回作業時のTODOリスト
// =============================================================================
//
//   [ ] ② Google FormのURLを実際のフォームURLに変更する
//         → 現在: "https://forms.google.com/"
//         → 変更先: Google Formで作成したフォームのURLを貼り付け
//
// TODO(優先度: 低)
//   [ ] ⑥ 新しいカテゴリの追加（例: SNSリンクカテゴリやツールカテゴリなど）
//         → categories配列にエントリを追加するだけで自動表示される
//   [ ] ⑦ 各リンクのdescriptionテキストを実際の言葉に微調整する
//
// =============================================================================

// リンクデータ（カテゴリ別）
// TODO ①②: 各urlフィールドを実際のURLに変更する
const categories = [
  {
    id: "01",
    key: "DEV_PROFILE",
    label: "DEV & PROFILE",
    sub: "CORE // IDENTITY",
    links: [
      {
        title: "GitHub",
        url: "https://github.com/taniguchi-46",
        description: "mainブランチで作業しがち",
        badge: "CORE",
        badgeColor: "bg-[#202836] text-white",
      },
      {
        title: "PROFILE PAGE",
        url: "/profile",
        description: "自己紹介、スキル、および自宅ラボのハードウェア構成一覧。",
        badge: "INTERNAL",
        badgeColor: "bg-[#EFEAE2] text-[#202836] border border-[#202836]",
      },
      {
        title: "BLOG",
        url: "/",
        description: "自宅サーバー構築記録と技術スタック実験の備忘録。",
        badge: "INTERNAL",
        badgeColor: "bg-[#EFEAE2] text-[#202836] border border-[#202836]",
      },
    ]
  },
  {
    id: "02",
    key: "LEARNING",
    label: "LEARNING & SOURCE",
    sub: "KNOWLEDGE // BASE",
    links: [
      {
        title: "フラッター教科書",
        url: "https://zenn.dev/heyhey1028/books/flutter-basics",
        description: "flutterの教科書",
        badge: "flutter",
        badgeColor: "bg-[#202836] text-white",
      },
    ]
  },
  {
    id: "03",
    key: "FAVORITES",
    label: "FAVORITES",
    sub: "CURATION // LIST",
    links: [
      {
        title: "フレデリック",
        url: "https://frederic-official.com/",
        description: "神戸にて結成された三原健司(Vo./Gt.)、三原康司(Ba.)の双子の兄弟と、赤頭隆児(Gt.)、高橋武(Dr.)で編成される4人組バンド。",
        badge: "Artist",
        badgeColor: "bg-[#202836] text-white",
      },
      {
        title: "ヨルシカ",
        url: "https://yorushika.com/",
        description: "コンポーザーの”n-buna”がボーカル”suis”を迎えて結成したバンド。",
        badge: "Artist",
        badgeColor: "bg-[#202836] text-white",
      },
      {
        title: "SKRYU",
        url: "https://skryu.bitfan.id/",
        description: "1996年生9月3日生まれ　島根県出身のラッパー。",
        badge: "Artist",
        badgeColor: "bg-[#202836] text-white",
      },
      {
        title: "suspended 4th",
        url: "https://suspended-4th.com/",
        description: "名古屋・栄の路上から現れたSuspended 4thは2013年結成。オンボーカルの楽曲からインストゥルメンタルのセッションまで熟し、多才なプレイで観る者を魅了し続けているロック・バンド。",
        badge: "Artist",
        badgeColor: "bg-[#202836] text-white",
      },
    ]
  }
  // {
  //   id: "",
  //   key: "",
  //   label: "",
  //   sub: "",
  //   links: [
  //     {
  //       title: "",
  //       url: "",
  //       description: "",
  //       badge: "",
  //       badgeColor: "bg-[#202836] text-white",
  //     },
  //   ]
  // }
  
];
---

<Layout title="LINKS">
  <!-- ページタイトル：無骨なソリッドヘッダー -->
  <PageHeader
    tag="NODE // LINKS_SECTOR"
    title="EXTERNAL"
    titleHighlight="LINKS."
    breakLine={false}
  />

  <!-- 縦積みカテゴリカード -->
  <div class="max-w-3xl mx-auto px-6 py-12 md:py-20 space-y-12">
    {categories.map((cat) => (
      <Card id={cat.id} title={cat.label} subtitle={cat.sub}>
        <!-- 【メインコンテンツ】リンク縦一覧 -->
        <div class="divide-y-[3px] divide-[#202836]">
          {cat.links.map((link) => (
            <a
              href={link.url}
              target={link.url.startsWith("http") ? "_blank" : "_self"}
              rel={link.url.startsWith("http") ? "noopener noreferrer" : ""}
              class="relative flex flex-col p-6 hover:bg-[#F5F2EB] transition-colors duration-200 group/link overflow-hidden"
            >
              <!-- 個別リンクのホバー赤線（細め） -->
              <div class="absolute left-0 top-0 bottom-0 w-[3px] bg-[#D60000] scale-y-0 group-hover/link:scale-y-100 transition-transform origin-top duration-200"></div>

              <div class="flex items-start justify-between gap-4 pl-2">
                <div class="space-y-1.5 flex-1 min-w-0">
                  <div class="flex items-center gap-2.5 flex-wrap">
                    <span class={`text-[9px] font-['Fira_Code'] font-black px-2 py-0.5 tracking-widest uppercase ${link.badgeColor}`}>
                      {link.badge}
                    </span>
                    <h3 class="text-sm md:text-base font-black text-[#202836] group-hover/link:text-[#D60000] transition-colors duration-200 truncate">
                      {link.title}
                    </h3>
                  </div>
                  <p class="text-xs text-[#4A5568] font-medium leading-relaxed">
                    {link.description}
                  </p>
                </div>
                <span class="text-xs font-black text-[#A0AEC0] group-hover/link:text-[#D60000] transition-colors duration-200 shrink-0 mt-0.5">
                  {link.url === "#" ? "—" : link.url.startsWith("http") ? "OPEN ↗" : "GO ➔"}
                </span>
              </div>
            </a>
          ))}
        </div>

        <!-- 【その他】フッター：カテゴリの件数表示 -->
        <div slot="footer" class="px-6 py-3 bg-[#F5F2EB] border-t-[3px] border-[#202836] flex items-center justify-between text-[10px] font-['Fira_Code'] font-bold text-[#A0AEC0] uppercase tracking-widest">
          <span>TOTAL: {cat.links.length} LINK{cat.links.length > 1 ? "S" : ""}</span>
          <span class="text-[#D60000]">// {cat.key}</span>
        </div>
      </Card>
    ))}
  </div>
</Layout>
