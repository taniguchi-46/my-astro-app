---
import Layout from "../layouts/Layout.astro";
import Article from "../components/Article.astro";
import PageHeader from "../components/PageHeader.astro";
import { getCollection } from "astro:content";

// 「VIEW ARCHIVES」ボタンの表示判定用に記事件数を取得
const allPosts = await getCollection("blog");
---

<Layout title="BLOG">
  <!-- メインビジュアル：横幅いっぱいの無骨なソリッドブロック -->
  <PageHeader
    tag="SYSTEM NODE: ACTIVE"
    tagPulse={true}
    title="SELF-HOSTING"
    titleHighlight="LOG & LAB."
    breakLine={true}
    description="自宅サーバー構築の備忘録と、技術スタックの実験場。<br />Linux Mint ＋ Docker 環境で稼働しているコンテナから爆速配信中。"
    maxWidthClass="max-w-7xl"
    paddingClass="py-20 md:py-28"
    headingSizeClass="text-5xl md:text-8xl"
    descriptionClass="mt-8 max-w-xl text-sm md:text-base"
    tagSpacingClass="mb-6"
    dotSizeClass="w-3.5 h-3.5"
  />

  <!-- ブログ記事一覧：共通スライダーコンポーネントを配置 -->
  <section class="max-w-7xl mx-auto px-6 py-12 md:py-20">
    <Article />

    {/* 記事数が3件より多い場合に「VIEW ARCHIVES」ボタンを表示 */}
    {allPosts.length > 3 && (
      <div class="mt-12 flex justify-center">
        <a
          href="/blog"
          class="inline-flex items-center justify-center gap-3 border-[3px] border-[#202836] bg-white text-[#202836] hover:bg-[#202836] hover:text-[#EFEAE2] font-black text-lg tracking-widest px-12 py-5 transition-all duration-300 group"
        >
          <span>VIEW ARCHIVES</span>
          <span class="text-[#D60000] group-hover:translate-x-1 transition-transform">➔</span>
        </a>
      </div>
    )}
  </section>
</Layout>
