---
import Layout from "../layouts/Layout.astro";

// =============================================================================
// PROFILE PAGE — 次回作業時のTODOリスト
// =============================================================================
//
// TODO(優先度: 高)
//   [ ] ① 自己紹介テキスト（WHO I AM）をkairoさん本人の文章に書き換える
//   [ ] ② スキルバッジ（CORE SKILLS）の内容を実際のスキルセットに更新する
//   [ ] ③ インフラスペック表（HOME LAB INFRA）の数値を実機スペックに書き換える
//         - MACHINE名、CPU型番、メモリ容量、ストレージ構成、稼働日数 など
//
// TODO(優先度: 中)
//   [ ] ④ ブログ記事一覧（RECENT LOGS）をダミーデータから
//         Astro Content Collectionsによる実際のMarkdown自動読み込みに切り替える
//         → src/content/config.ts の設定 + src/content/blog/*.md の作成が前提
//   [ ] ⑤ 「KR」アイコンを実際のアバター画像（またはロゴ画像）に変更する
//
// TODO(優先度: 低)
//   [ ] ⑥ uptime / temperature などのダミーステータス表示を
//         必要に応じてリアルタイム取得APIに接続する（または固定値で運用）
//   [ ] ⑦ Linksへの「DIRECT ROUTE」カードのコピー文を微調整する
//
// =============================================================================

// ブログ記事のダミーデータ（最新3件をPROFILE用に格納）
// TODO: ④ 実装時は getCollection('blog') に置き換える
const recentPosts = [
  {
    slug: "docker-permission-fixed",
    title: "Linux Mint サーバーの Docker 権限バグ解消手順",
    pubDate: "2026.05.28",
  },
  {
    slug: "astro-tailwind-minimalism",
    title: "Astro v5 + Tailwind CSS で作るソリッド・ミニマルな思想",
    pubDate: "2026.05.29",
  },
];
---

<Layout title="PROFILE">
  <!-- ページタイトル：無骨なソリッドヘッダー -->
  <!-- TODO ⑦: 必要であればサブタイトルのコピー文を変更 -->
  <section class="border-b-[3px] border-[#202836] bg-white">
    <div class="max-w-3xl mx-auto px-6 py-16 md:py-20">
      <div class="flex items-center space-x-2.5 mb-4">
        <span class="w-3 h-3 bg-[#D60000] rounded-full"></span>
        <span
          class="text-xs font-['Fira_Code'] font-bold tracking-widest text-[#D60000] uppercase"
        >
          NODE // PROFILE_SECTOR
        </span>
      </div>
      <h1
        class="text-4xl md:text-6xl font-black tracking-tighter leading-none text-[#202836] uppercase select-none"
      >
        ABOUT <span class="text-[#D60000]">KAIRO.</span>
      </h1>
      <p
        class="mt-4 text-[#4A5568] font-medium text-xs md:text-sm leading-relaxed"
      >
        ポートフォリオ、自宅サーバーハードウェア構成、および活動ログの集約。
      </p>
    </div>
  </section>

  <!-- 縦積みソリッドカードセクション -->
  <div class="max-w-3xl mx-auto px-6 py-12 md:py-20 space-y-12">
    <!-- ===================================================================
         カード 01: 自己紹介 (WHO I AM)
         TODO ①: 自己紹介テキストをkairoさん自身の言葉に書き換える
         TODO ②: スキルバッジの内容を実際のスキルセットに更新する
         TODO ⑤: 「KR」テキストアイコンをアバター画像 <img src="/avatar.png"> に変更する
         =================================================================== -->
    <!-- カード 01: 自己紹介 (WHO I AM) -->
    <section
      class="group relative bg-white border-[3px] border-[#202836] flex flex-col overflow-hidden hover:-translate-x-1.5 hover:-translate-y-1.5 hover:shadow-[6px_6px_0px_0px_#202836] transition-all duration-300"
    >
      <!-- ホバー時に左端からスッと出現するメカニカル赤線 -->
      <div
        class="absolute left-0 top-0 bottom-0 w-[5px] bg-[#D60000] scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300 z-10"
      >
      </div>

      <!-- 【見出し】 -->
      <div
        class="bg-[#202836] px-6 py-4 border-b-[3px] border-[#202836] flex items-center justify-between"
      >
        <h2
          class="font-['Fira_Code'] font-black tracking-widest text-sm md:text-base text-white"
        >
          01 // WHO I AM
        </h2>
        <span
          class="text-[10px] font-['Fira_Code'] text-[#A0AEC0] font-bold uppercase tracking-wider"
          >PORTFOLIO // SECTOR</span
        >
      </div>

      <!-- 【メインコンテンツ】 -->
      <div class="p-6 md:p-8 space-y-6">
        <div class="flex items-center space-x-4">
          <div
            class="w-14 h-14 bg-[#202836] text-white font-['Fira_Code'] font-black text-2xl flex items-center justify-center border-2 border-[#202836]"
          >
            AA
          </div>
          <div>
            <h3 class="text-xl font-black text-[#202836]">kairo</h3>
            <p
              class="text-xs font-bold text-[#A0AEC0] tracking-wider uppercase font-['Fira_Code']"
            >
            </p>
          </div>
        </div>

        <ul>
          <li>
            清風情報工科学院/デザイン・コンピュータ学科/システム専攻 28年卒
          </li>
          <li>趣味：ゲーム, ギター, 料理</li>
          <li>
            好きなアーティスト：フレデリック, ヨルシカ, MOROHA, SKRYU, etc...
          </li>
          <li>座右の銘：臥薪嘗胆</li>
        </ul>

        <div class="pt-4 border-t border-[#F1F5F9] space-y-3">
          <h4
            class="text-xs font-['Fira_Code'] font-black tracking-widest text-[#202836] uppercase"
          >
            // 資格
          </h4>
          <div class="flex flex-wrap gap-2">
            {
              [
                "基本情報技術者",
                "ITパスポート",
                "MOS Associate",
                "J検3級",
                "普通自動二輪（小型AT限定）",
              ].map((skill) => (
                <span class="text-[10px] font-['Fira_Code'] font-bold text-[#202836] border border-[#202836] px-2.5 py-0.5 uppercase tracking-wider bg-white">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>
      </div>

      <!-- 【その他】 -->
      <div
        class="px-6 py-4 bg-[#F5F2EB] border-t-[3px] border-[#202836] flex items-center justify-between text-xs font-bold text-[#4A5568]"
      >
        <span></span>
        <span class="text-[#A0AEC0]"></span>
      </div>
    </section>

    <!-- ===================================================================
         カード 02: 
         
         =================================================================== -->
    <!-- カード 02:  -->
    <section
      class="group relative bg-white border-[3px] border-[#202836] flex flex-col overflow-hidden hover:-translate-x-1.5 hover:-translate-y-1.5 hover:shadow-[6px_6px_0px_0px_#202836] transition-all duration-300"
    >
      <div
        class="absolute left-0 top-0 bottom-0 w-[5px] bg-[#D60000] scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300 z-10"
      >
      </div>

      <!-- 【見出し】 -->
      <div
        class="bg-[#202836] px-6 py-4 border-b-[3px] border-[#202836] flex items-center justify-between"
      >
        <h2
          class="font-['Fira_Code'] font-black tracking-widest text-sm md:text-base text-white"
        >
          02 // やりたいことリスト
        </h2>
        <span
          class="text-[10px] font-['Fira_Code'] text-[#A0AEC0] font-bold uppercase tracking-wider"
          >Bucket List</span
        >
      </div>

      <!-- 【メインコンテンツ】 -->
      <div class="p-6 md:p-8 space-y-6">
        <!-- 無骨なインダストリアルスペック表 -->
        <div class="border-[3px] border-[#202836] overflow-hidden">
          <table
            class="w-full text-left border-collapse text-xs md:text-sm font-medium"
          >
            <thead>
              <tr
                class="bg-[#202836] text-white font-['Fira_Code'] text-[11px] md:text-xs"
              >
                <th class="p-3 border-r-2 border-[#202836]">Lineage</th>
                <th class="p-3">Contents</th>
              </tr>
            </thead>
            <tbody class="divide-y-2 divide-[#202836]">
              <tr>
                <td
                  class="p-3 bg-[#F5F2EB] font-['Fira_Code'] font-bold border-r-2 border-[#202836] text-[#202836] w-1/3"
                  >技術系</td
                >
                <td class="p-3 text-[#4A5568] font-bold">
                  <ul>
                    <li>Windowsアプリ 音声検知</li>
                    <li>Flutter Android ui構築練習</li>
                    <li>Ruby on Rails</li>
                    <li>Go</li>
                    <li>サーバー、Linux関連</li>
                    <li>Webサイト系</li>
                    <li>メモアプリ</li>
                    <li>競馬情報ライン送信アプリ</li>
                  </ul>
                </td>
              </tr>
              <td
                class="p-3 bg-[#F5F2EB] font-['Fira_Code'] font-bold border-r-2 border-[#202836] text-[#202836] w-1/3"
                >趣味系</td
              >
              <td class="p-3 text-[#4A5568] font-bold">
                <ul>
                  <li>VALORANT</li>
                  <li>Overwatch</li>
                  <li>マイクラ</li>
                  <li>ハーメルン</li>
                </ul>
              </td>
              <tr> </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 【その他】 -->
      <div
        class="px-6 py-4 bg-[#F5F2EB] border-t-[3px] border-[#202836] flex items-center justify-between text-xs font-bold text-[#4A5568]"
      >
        <div class="flex items-center space-x-1.5"></div>
      </div>
    </section>

    <!-- ===================================================================
         カード 03: ブログ記事一覧 (RECENT LOGS)
         TODO ④: 現在はダミーデータ配列で表示中。
           実際のMarkdown記事が揃ったら以下の手順で切り替える:
           1. src/content/config.ts で blog コレクション定義
           2. src/content/blog/*.md に記事を作成
           3. frontmatterの import recentPosts を
              const allPosts = await getCollection('blog');
              const recentPosts = allPosts.slice(0, 3); に変更
         =================================================================== -->
    <!-- カード 03: ブログ記事一覧 (RECENT LOGS) -->
    <section
      class="group relative bg-white border-[3px] border-[#202836] flex flex-col overflow-hidden hover:-translate-x-1.5 hover:-translate-y-1.5 hover:shadow-[6px_6px_0px_0px_#202836] transition-all duration-300"
    >
      <div
        class="absolute left-0 top-0 bottom-0 w-[5px] bg-[#D60000] scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300 z-10"
      >
      </div>

      <!-- 【見出し】 -->
      <div
        class="bg-[#202836] px-6 py-4 border-b-[3px] border-[#202836] flex items-center justify-between"
      >
        <h2
          class="font-['Fira_Code'] font-black tracking-widest text-sm md:text-base text-white"
        >
          03 // RECENT LOGS
        </h2>
        <span
          class="text-[10px] font-['Fira_Code'] text-[#A0AEC0] font-bold uppercase tracking-wider"
          >JOURNAL // ARCHIVE</span
        >
      </div>

      <!-- 【メインコンテンツ】 -->
      <div class="p-6 md:p-8 space-y-4">
        <p class="text-[#4A5568] text-sm leading-relaxed font-medium">
          最近執筆された活動ログと技術的なメモ。
        </p>

        <!-- シンプルな縦積みブログ記事リスト -->
        <div
          class="border-[3px] border-[#202836] divide-y-[3px] divide-[#202836]"
        >
          {
            recentPosts.map((post) => (
              <div class="p-5 hover:bg-[#F5F2EB] transition-colors flex items-center justify-between gap-4">
                <div class="space-y-1">
                  <span class="text-[10px] font-['Fira_Code'] font-bold text-[#A0AEC0]">
                    {post.pubDate}
                  </span>
                  <h4 class="text-sm md:text-base font-black text-[#202836] line-clamp-1">
                    {post.title}
                  </h4>
                </div>
                <a
                  href={`/blog/${post.slug}`}
                  class="text-xs font-bold text-[#202836] hover:text-[#D60000] transition-colors shrink-0"
                >
                  READ ➔
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <!-- 【その他】 -->
      <a
        href="/"
        class="px-6 py-5 bg-[#F5F2EB] border-t-[3px] border-[#202836] hover:bg-[#D60000] hover:text-white transition-colors duration-200 flex items-center justify-between group/btn text-xs font-black text-[#202836] tracking-wider uppercase"
      >
        <span>VIEW ALL POSTS IN BLOG</span>
        <span
          class="group-hover/btn:translate-x-1.5 transition-transform duration-200"
          >➔</span
        >
      </a>
    </section>

    <!-- ===================================================================
         カード 04: LINKSページへのリンク (DIRECT ROUTE)
         TODO ⑦: 必要であれば誘導コピー文を微調整する
                  （現状は土台テキストのまま）
         =================================================================== -->
    <!-- カード 04: LINKSページへのリンク (DIRECT ROUTE) -->
    <section
      class="group relative bg-white border-[3px] border-[#202836] flex flex-col overflow-hidden hover:-translate-x-1.5 hover:-translate-y-1.5 hover:shadow-[6px_6px_0px_0px_#202836] transition-all duration-300"
    >
      <div
        class="absolute left-0 top-0 bottom-0 w-[5px] bg-[#D60000] scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300 z-10"
      >
      </div>

      <!-- 【見出し】 -->
      <div
        class="bg-[#202836] px-6 py-4 border-b-[3px] border-[#202836] flex items-center justify-between"
      >
        <h2
          class="font-['Fira_Code'] font-black tracking-widest text-sm md:text-base text-white"
        >
          04 // DIRECT ROUTE
        </h2>
        <span
          class="text-[10px] font-['Fira_Code'] text-[#A0AEC0] font-bold uppercase tracking-wider"
          >NAVIGATE // LINK</span
        >
      </div>

      <!-- 【メインコンテンツ】 -->
      <div class="p-6 md:p-8 space-y-4">
        <p
          class="text-[#4A5568] text-sm md:text-base leading-relaxed font-medium"
        >
          GitHub、技術的なおすすめ情報ソース、お気に入りのWebサービス、Googleフォーム等、他サービスや各種外部リソースへのランチャーページへ直接アクセスします。
        </p>
      </div>

      <!-- 【その他】 -->
      <a
        href="/links"
        class="px-6 py-5 bg-[#D60000] text-white border-t-[3px] border-[#202836] hover:bg-[#990000] transition-colors duration-200 flex items-center justify-between group/btn text-xs font-black tracking-wider uppercase"
      >
        <span>GO TO LINKS LAUNCHER</span>
        <span
          class="group-hover/btn:translate-x-1.5 transition-transform duration-200"
          >➔</span
        >
      </a>
    </section>
  </div>
</Layout>
