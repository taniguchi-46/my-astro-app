---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Card from "../components/Card.astro";
---

<Layout title="PROFILE">
  <PageHeader
    tag="NODE // PROFILE_SECTOR"
    title="ABOUT"
    titleHighlight="KAIRO."
    breakLine={false}
    description=""
  />
  <div class="max-w-3xl mx-auto px-6 py-12 md:py-20 space-y-12">
    <Card title="WHO I AM" subtitle="PORTFOLIO // SECTOR">
      <div class="p-6 md:p-8 space-y-6">
        <div class="flex items-center space-x-4">
          <div
            class="w-14 h-14 bg-[#202836] text-white font-['Fira_Code'] font-black text-2xl flex items-center justify-center border-2 border-[#202836]"
          >
            AA
          </div>
          <div>
            <h3 class="text-xl font-black text-[#202836]">kairo</h3>
            <p
              class="text-xs font-bold text-[#A0AEC0] tracking-wider uppercase font-['Fira_Code']"
            >
            </p>
          </div>
        </div>

        <ul>
          <li></li>
          <li>趣味: ゲーム, ギター, 料理</li>
          <li>
            好きなアーティスト: フレデリック, ヨルシカ, MOROHA, SKRYU, etc...
          </li>
          <li>座右の銘: 臥薪嘗胆</li>
        </ul>
      </div>
      <div
        slot="footer"
        class="px-6 py-4 bg-[#F5F2EB] border-t-[3px] border-[#202836] flex items-center justify-between text-xs font-bold text-[#4A5568]"
      >
        <span></span>
        <span class="text-[#A0AEC0]"></span>
      </div>
    </Card>
    <Card title="やりたいことリスト" subtitle="Bucket List">
      <div class="p-6 md:p-8 space-y-6">
        <div class="border-[3px] border-[#202836] overflow-hidden">
          <table
            class="w-full text-left border-collapse text-xs md:text-sm font-medium"
          >
            <thead>
              <tr
                class="bg-[#202836] text-white font-['Fira_Code'] text-[11px] md:text-xs"
              >
                <th class="p-3 border-r-2 border-[#202836]">Lineage</th>
                <th class="p-3">Contents</th>
              </tr>
            </thead>
            <tbody class="divide-y-2 divide-[#202836]">
              <tr>
                <td
                  class="p-3 bg-[#F5F2EB] font-['Fira_Code'] font-bold border-r-2 border-[#202836] text-[#202836] w-1/3"
                  >技術系</td
                >
                <td class="p-3 text-[#4A5568] font-bold">
                  <ul>
                    <li>Windowsアプリ 音声認識</li>
                    <li>Flutter Android UI構築練習</li>
                    <li>Ruby on Rails</li>
                    <li>Go</li>
                    <li>サーバー / Linux関連</li>
                    <li>Webサイト制作</li>
                    <li>メモアプリ</li>
                    <li>競馬情報ライン配信アプリ</li>
                  </ul>
                </td>
              </tr>
              <tr>
                <td
                  class="p-3 bg-[#F5F2EB] font-['Fira_Code'] font-bold border-r-2 border-[#202836] text-[#202836] w-1/3"
                  >趣味系</td
                >
                <td class="p-3 text-[#4A5568] font-bold">
                  <ul>
                    <li>VALORANT</li>
                    <li>Overwatch</li>
                    <li>マインクラフト</li>
                    <li>ハーメルン</li>
                  </ul>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <div
        slot="footer"
        class="px-6 py-4 bg-[#F5F2EB] border-t-[3px] border-[#202836] flex items-center justify-between text-xs font-bold text-[#4A5568]"
      >
        <div class="flex items-center space-x-1.5"></div>
      </div>
    </Card>
    <Card title="DIRECT ROUTE" subtitle="NAVIGATE // LINK">
      <div class="p-6 md:p-8 space-y-4">
        <p
          class="text-[#4A5568] text-sm md:text-base leading-relaxed font-medium"
        >
          GitHub、情報ソース、お気に入りのWebサービスなど、外部リソースへのリンクページへ移動します。
        </p>
      </div>
      <a
        slot="footer"
        href="/links"
        class="px-6 py-5 bg-[#D60000] text-white border-t-[3px] border-[#202836] hover:bg-[#990000] transition-colors duration-200 flex items-center justify-between group/btn text-xs font-black tracking-wider uppercase"
      >
        <span>GO TO LINKS LAUNCHER</span>
        <span
          class="group-hover/btn:translate-x-1.5 transition-transform duration-200"
          >→</span
        >
      </a>
    </Card>

    <section
      class="flex justify-center"
      aria-labelledby="career-treasure-title"
    >
      <div class="w-full max-w-lg">
        <h2 id="career-treasure-title" class="sr-only">就活用プロフィール</h2>
        <button
          id="career-chest-button"
          type="button"
          aria-haspopup="dialog"
          aria-controls="career-gate-modal"
          class="group mx-auto block w-full max-w-48 border-[3px] border-[#202836] bg-white p-3 transition-all duration-300 hover:-translate-x-1.5 hover:-translate-y-1.5 hover:shadow-[6px_6px_0px_0px_#202836] focus:outline-none focus:ring-4 focus:ring-[#D60000]/30"
          aria-label="プロフィールの合言葉入力を開く"
        >
          <img
            src="/takarabako.png"
            alt=""
            class="mx-auto aspect-square w-full object-contain transition-transform duration-300 group-hover:scale-[1.03]"
            loading="lazy"
          />
        </button>
      </div>
    </section>
  </div>

  <div
    id="career-gate-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-[#202836]/70 px-6 py-10"
    role="dialog"
    aria-modal="true"
    aria-labelledby="career-gate-title"
  >
    <div id="career-gate-backdrop" class="absolute inset-0" aria-hidden="true">
    </div>
    <section
      class="relative w-full max-w-md border-[3px] border-[#202836] bg-white shadow-[8px_8px_0px_0px_#202836]"
    >
      <div
        class="flex items-center justify-between border-b-[3px] border-[#202836] bg-[#202836] px-5 py-4"
      >
        <div>
          <p
            class="font-['Fira_Code'] text-[10px] font-black uppercase tracking-widest text-[#A0AEC0]"
          >
            CAREER // ACCESS
          </p>
          <h2 id="career-gate-title" class="text-lg font-black text-white">
            LOCKED ROUTE
          </h2>
        </div>
        <button
          id="career-gate-close"
          type="button"
          class="border-2 border-white px-3 py-1 font-['Fira_Code'] text-xs font-black text-white transition-colors hover:bg-white hover:text-[#202836]"
          aria-label="合言葉入力を閉じる"
        >
          X
        </button>
      </div>

      <form id="career-gate-form" class="space-y-4 p-5 md:p-6">
        <label
          for="career-passphrase"
          class="block text-xs font-['Fira_Code'] font-black uppercase tracking-widest text-[#202836]"
        >
          Passphrase
        </label>
        <input
          id="career-passphrase"
          type="password"
          autocomplete="off"
          placeholder="合言葉"
          class="w-full border-[3px] border-[#202836] bg-[#F5F2EB] px-4 py-3 text-sm font-bold text-[#202836] outline-none focus:bg-white focus:ring-2 focus:ring-[#D60000]"
        />
        <p
          id="career-gate-message"
          class="min-h-5 text-xs font-bold text-[#D60000]"
          aria-live="polite"
        >
        </p>
        <div class="grid grid-cols-2 gap-3">
          <button
            id="career-gate-cancel"
            type="button"
            class="border-[3px] border-[#202836] bg-white px-4 py-3 text-xs font-black uppercase tracking-widest text-[#202836] transition-colors hover:bg-[#F5F2EB]"
          >
            CANCEL
          </button>
          <button
            type="submit"
            class="border-[3px] border-[#202836] bg-[#D60000] px-4 py-3 text-xs font-black uppercase tracking-widest text-white transition-colors hover:bg-[#990000]"
          >
            OPEN
          </button>
        </div>
      </form>
    </section>
  </div>
</Layout>

<script>
  const careerChestButton = document.getElementById("career-chest-button");
  const careerGateModal = document.getElementById("career-gate-modal");
  const careerGateBackdrop = document.getElementById("career-gate-backdrop");
  const careerGateClose = document.getElementById("career-gate-close");
  const careerGateCancel = document.getElementById("career-gate-cancel");
  const careerGateForm = document.getElementById("career-gate-form");
  const careerPassphrase = document.getElementById("career-passphrase");
  const careerGateMessage = document.getElementById("career-gate-message");
  const careerPassphraseHashes = [
    "b48a4a11a8b334ede587e27a12316b9e621a5bb43214ceeeb57e7eb3a35e703c",
  ];

  const digestText = async (text: string) => {
    const bytes = new TextEncoder().encode(text);
    const digest = await crypto.subtle.digest("SHA-256", bytes);
    return [...new Uint8Array(digest)]
      .map((byte) => byte.toString(16).padStart(2, "0"))
      .join("");
  };

  const openCareerGate = () => {
    careerGateModal?.classList.remove("hidden");
    careerGateModal?.classList.add("flex");
    if (careerPassphrase instanceof HTMLInputElement) {
      careerPassphrase.value = "";
      careerPassphrase.removeAttribute("aria-invalid");
      careerPassphrase.focus();
    }
    if (careerGateMessage) {
      careerGateMessage.textContent = "";
    }
  };

  const closeCareerGate = () => {
    careerGateModal?.classList.add("hidden");
    careerGateModal?.classList.remove("flex");
    careerChestButton?.focus();
  };

  careerChestButton?.addEventListener("click", openCareerGate);
  careerGateClose?.addEventListener("click", closeCareerGate);
  careerGateCancel?.addEventListener("click", closeCareerGate);
  careerGateBackdrop?.addEventListener("click", closeCareerGate);

  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      !careerGateModal?.classList.contains("hidden")
    ) {
      closeCareerGate();
    }
  });

  careerGateForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!(careerPassphrase instanceof HTMLInputElement)) return;

    const inputValue = careerPassphrase.value.trim().toLowerCase();
    const inputHash = await digestText(inputValue);
    const canOpen = careerPassphraseHashes.includes(inputHash);

    if (canOpen) {
      window.location.href = "/career";
      return;
    }

    careerPassphrase.setAttribute("aria-invalid", "true");
    if (careerGateMessage) {
      careerGateMessage.textContent = "合言葉が違います。";
    }
  });
</script>
