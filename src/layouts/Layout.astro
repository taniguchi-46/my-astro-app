---
// 全ページ共通の土台コンポーネント
interface Props {
	title: string;
	showLatestPosts?: boolean;
}

const { title, showLatestPosts = true } = Astro.props;

import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Loader from "../components/Loader.astro";
import Article from "../components/Article.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | KAIRO'S LAB</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Noto+Sans+JP:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class="bg-[#EFEAE2] text-[#202836] font-['Noto_Sans_JP'] min-h-screen flex flex-col selection:bg-[#D60000] selection:text-white"
	>
		<Loader />

		<Header />

		<main class="grow">
			<slot />
		</main>

		{
			showLatestPosts && (
				<div class="relative">
					<div class="h-[3px] bg-[#202836] rounded-full"></div>
				</div>
				<section class="max-w-7xl mx-auto px-6 py-12 md:py-20">
					<Article />
					{allPosts.length > 3 && (
						<div class="mt-12 flex justify-center">
							<a
								href="/blog"
								class="inline-flex items-center justify-center gap-3  bg-white text-[#202836] hover:bg-[#202836] hover:text-[#EFEAE2] font-black text-lg tracking-widest px-12 py-5 transition-all duration-300 group"
							>
								<span>VIEW ARCHIVES</span>
								<span class="text-[#D60000] group-hover:translate-x-1 transition-transform">
									➔
								</span>
							</a>
						</div>
					)}
				</section>
			)
		}

		<Footer />

		<!-- ローディング終了時の遷移時など、ここには何も記述せずにLoaderに閉じ込めています -->
	</body>
</html>

<style is:global>
	/* 全ページ共通のスタイル調整 */
	html {
		scroll-behavior: smooth;
	}
	/* スクロールバーもインダストリアルに */
	::-webkit-scrollbar {
		width: 8px;
	}
	/* スクロールバーのベージュカラー調整 */
	::-webkit-scrollbar-track {
		background: #efeae2;
	}
	::-webkit-scrollbar-thumb {
		background: #202836;
	}

	/* --- モンドリアン・ローディングアニメーション --- */

	/* 1. ブロックの高速飛来エフェクト */
	.block-fly-in {
		opacity: 0;
		animation: flyInBlock 0.85s cubic-bezier(0.19, 1, 0.22, 1) forwards;
		animation-delay: var(--delay);
	}

	@keyframes flyInBlock {
		0% {
			transform: translate(var(--fly-x, 0), var(--fly-y, 0));
			opacity: 0;
		}
		100% {
			transform: translate(0, 0);
			opacity: 1;
		}
	}

	/* 2. 中央幾何学ロゴのメカニカルスナップ組み立て */

	/* 水平メインライン：左端からスライド伸長 */
	.logo-horizontal {
		transform: scaleX(0);
		transform-origin: left;
		animation: logoDrawX 0.4s cubic-bezier(0.19, 1, 0.22, 1) forwards;
		animation-delay: 0.65s;
	}
	@keyframes logoDrawX {
		to {
			transform: scaleX(1);
		}
	}

	/* 左側斜めライン：左下から精密にスライドイン */
	.logo-diag-left {
		opacity: 0;
		transform: translate(-30px, 30px);
		animation: logoDiagSnap 0.35s cubic-bezier(0.19, 1, 0.22, 1) forwards;
		animation-delay: 0.85s;
	}
	@keyframes logoDiagSnap {
		to {
			opacity: 1;
			transform: translate(0, 0);
		}
	}

	/* 左側縦長方形：上からカチッとスナップ */
	.logo-rect-left {
		opacity: 0;
		transform: scaleY(0);
		transform-origin: top;
		animation: logoSnapRect 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.15)
			forwards; /* わずかに弾むクリック感 */
		animation-delay: 1.05s;
	}

	/* 右側縦長方形（下端傾斜）：下からカチッとスナップ */
	.logo-rect-right {
		opacity: 0;
		transform: scaleY(0);
		transform-origin: bottom;
		animation: logoSnapRect 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.15)
			forwards;
		animation-delay: 1.2s;
	}
	@keyframes logoSnapRect {
		to {
			opacity: 1;
			transform: scaleY(1);
		}
	}

	/* 右側斜め・水平複合ライン：右端から精密スライド組み立て */
	.logo-diag-right {
		opacity: 0;
		transform: translate(30px, -30px);
		animation: logoDiagSnap 0.35s cubic-bezier(0.19, 1, 0.22, 1) forwards;
		animation-delay: 1.35s;
	}
</style>
