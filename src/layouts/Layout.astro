---
// 全ページ共通の土台コンポーネント
interface Props {
	title: string;
}

const { title } = Astro.props;

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | KAIRO'S LAB</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Noto+Sans+JP:wght@400;700;900&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#EFEAE2] text-[#202836] font-['Noto_Sans_JP'] min-h-screen flex flex-col selection:bg-[#D60000] selection:text-white">
		<Header />
		
		<main class="grow">
			<slot /> 
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	/* 全ページ共通のスタイル調整 */
	html {
		scroll-behavior: smooth;
	}
	/* スクロールバーもインダストリアルに */
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: #EFEAE2;
	}
	::-webkit-scrollbar-thumb {
		background: #202836;
	}
</style>

