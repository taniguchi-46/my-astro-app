---
import type { BlogPost } from "../lib/blog";
import Card from "./Card.astro";

interface Props {
  posts: BlogPost[];
  totalPosts: number;
  currentPage?: number;
  lastPage?: number;
}

const { posts, totalPosts, currentPage, lastPage } = Astro.props;
---

<h2
  class="text-3xl font-medium leading-15 text-[#202836] mb-8 font-['Fira_Code']"
>
  ALL POSTS ({totalPosts})
</h2>

{
  lastPage && lastPage > 1 && currentPage && (
    <p class="mb-8 text-xs md:text-sm font-['Fira_Code'] font-bold tracking-widest text-[#4A5568]">
      PAGE {currentPage} / {lastPage}
    </p>
  )
}

{
  posts.length > 0 ? (
    <div class="flex flex-col gap-8">
      {posts.map((post) => {
        const pubDate =
          post.data.pubDate instanceof Date
            ? post.data.pubDate
            : new Date(post.data.pubDate);
        const dateStr = pubDate
          .toLocaleDateString("ja-JP", {
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
          })
          .replace(/\//g, ".");

        return (
          <Card title={post.data.title} subtitle={dateStr}>
            {/* メインコンテンツ */}
            <div class="px-6 py-6 flex-grow">
              <p class="text-sm text-[#4A5568] leading-relaxed font-medium">
                {post.data.description}
              </p>
            </div>

            {/* フッター */}
            <div
              slot="footer"
              class="px-6 py-4 bg-[#F8FAFC] border-t-2 border-[#202836] flex items-center justify-between gap-4"
            >
              <div class="flex flex-wrap gap-1.5">
                {post.data.tags?.map((tag) => (
                  <span class="text-[10px] font-['Fira_Code'] font-bold text-[#202836] border border-[#202836] px-2 py-0.5 uppercase tracking-wider bg-white">
                    {tag}
                  </span>
                ))}
              </div>
              <a
                href={`/blog/${post.id}`}
                class="text-xs font-bold text-[#202836] hover:text-[#D60000] transition-colors duration-200 flex items-center shrink-0"
              >
                READ MORE{" "}
                <span class="ml-1 text-[#D60000] font-bold">➔</span>
              </a>
            </div>
          </Card>
        );
      })}
    </div>
  ) : (
    <div class="border-[3px] border-[#202836] bg-white p-12 text-center">
      <p class="text-lg font-bold text-[#4A5568]">
        記事が見つかりませんでした。
      </p>
    </div>
  )
}
