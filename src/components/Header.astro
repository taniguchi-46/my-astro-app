---
// ヘッダーコンポーネント（3本立てミニマルメニュー搭載）
---

<header class="border-b-[3px] border-[#202836] bg-white sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    
    <a href="/" class="flex items-center space-x-3 group">
      <span class="w-3.5 h-3.5 bg-[#D60000] rounded-full group-hover:scale-110 transition-transform"></span>
      <span class="text-lg font-['Fira_Code'] font-black tracking-wider text-[#202836]">KAIRO'S LAB</span>
    </a>

    <button 
      id="menu-btn" 
      class="border-2 border-[#202836] p-2 hover:bg-[#EFEAE2] transition-colors focus:outline-none"
      aria-label="メニューを開閉"
    >
      <div class="w-6 h-4 flex flex-col justify-between relative">
        <span id="line1" class="w-full h-0.75 bg-[#202836] transition-transform duration-300 origin-left"></span>
        <span id="line2" class="w-full h-0.75 bg-[#202836] transition-transform duration-300 origin-left"></span>
      </div>
    </button>

  </div>

  <nav 
    id="menu-panel" 
    class="absolute left-0 right-0 top-16 bg-[#202836] hidden border-b-[3px] border-[#202836]"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-0">
      <a href="/" class="bg-white text-center py-8 border-b-2 md:border-b-0 md:border-r-2 border-[#202836] hover:bg-[#EFEAE2] hover:text-[#D60000] transition-colors font-black text-xl tracking-widest">
        <span class="text-xs font-['Fira_Code'] text-[#A0AEC0] block mb-1">01</span>
        BLOG
      </a>
      <a href="/profile" class="bg-white text-center py-8 border-b-2 md:border-b-0 md:border-r-2 border-[#202836] hover:bg-[#EFEAE2] hover:text-[#D60000] transition-colors font-black text-xl tracking-widest">
        <span class="text-xs font-['Fira_Code'] text-[#A0AEC0] block mb-1">02</span>
        PROFILE
      </a>
      <a href="/links" class="bg-white text-center py-8 hover:bg-[#EFEAE2] hover:text-[#D60000] transition-colors font-black text-xl tracking-widest">
        <span class="text-xs font-['Fira_Code'] text-[#A0AEC0] block mb-1">03</span>
        LINKS
      </a>
    </div>
  </nav>
</header>

<script>
  // ハンバーガーメニューの開閉JavaScript
  const menuBtn = document.getElementById('menu-btn');
  const menuPanel = document.getElementById('menu-panel');
  const line1 = document.getElementById('line1');
  const line2 = document.getElementById('line2');

  menuBtn?.addEventListener('click', () => {
    // パネルの表示/非表示を切り替え
    menuPanel?.classList.toggle('hidden');

    // アイコンの変形（三本線/二本線をクロスさせるロック風アニメーション）
    line1?.classList.toggle('rotate-[35deg]');
    line1?.classList.toggle('translate-x-[2px]');
    
    line2?.classList.toggle('-rotate-[35deg]');
    line2?.classList.toggle('translate-x-[2px]');
    line2?.classList.toggle('w-[112%]'); // バツ印の線を綺麗に合わせる調整
  });
</script>