---
// ヘッダーコンポーネント（3本立てミニマルメニュー搭載）
---

<header class="border-b-[3px] border-[#202836] bg-white sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center space-x-3 group">
      <span
        class="w-3.5 h-3.5 bg-[#D60000] rounded-full group-hover:scale-110 transition-transform"
      ></span>
      <span
        class="text-lg font-['Fira_Code'] font-black tracking-wider text-[#202836]"
        >KAIRO'S LAB</span
      >
    </a>

    <button
      id="menu-btn"
      class="border-2 border-[#202836] p-2 hover:bg-[#EFEAE2] transition-colors focus:outline-none"
      aria-label="メニューを開閉"
    >
      <div
        class="w-6 h-4 flex flex-col justify-between relative overflow-hidden"
      >
        <span
          id="line1"
          class="w-full h-0.5 bg-[#202836] transition-all duration-300"></span>
        <span
          id="line2"
          class="w-full h-0.5 bg-[#202836] transition-all duration-300"></span>
        <span
          id="line3"
          class="w-full h-0.5 bg-[#202836] transition-all duration-300"></span>
      </div>
    </button>
  </div>

  <nav
    id="menu-panel"
    class="absolute left-0 right-0 top-16 bg-white hidden border-b-[3px] border-[#202836]"
  >
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-row overflow-x-auto">
        <a href="/" class="bg-white text-center w-48 md:w-56 py-6 hover:bg-[#EFEAE2] hover:text-[#D60000] transition-colors font-black text-lg md:text-xl tracking-widest flex items-center justify-center gap-3 group relative overflow-hidden">
          <!-- 装飾用のアクティブ赤線 (ホバー時に左端からスッと出現するメカニカルギミック) -->
          <div class="absolute left-0 top-0 bottom-0 w-1 bg-[#D60000] scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
          <span class="text-xs font-['Fira_Code'] text-[#A0AEC0] group-hover:text-[#D60000]/70 transition-colors">00</span>
          TOP
        </a>
        <a href="/" class="bg-white text-center w-48 md:w-56 py-6 hover:bg-[#EFEAE2] hover:text-[#D60000] transition-colors font-black text-lg md:text-xl tracking-widest flex items-center justify-center gap-3 group relative overflow-hidden">
          <!-- 装飾用のアクティブ赤線 (ホバー時に左端からスッと出現するメカニカルギミック) -->
          <div class="absolute left-0 top-0 bottom-0 w-1 bg-[#D60000] scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
          <span class="text-xs font-['Fira_Code'] text-[#A0AEC0] group-hover:text-[#D60000]/70 transition-colors">01</span>
          BLOG
        </a>
        <a href="/profile" class="bg-white text-center w-48 md:w-56 py-6 hover:bg-[#EFEAE2] hover:text-[#D60000] transition-colors font-black text-lg md:text-xl tracking-widest flex items-center justify-center gap-3 group relative overflow-hidden">
          <!-- 装飾用のアクティブ赤線 (ホバー時に左端からスッと出現するメカニカルギミック) -->
          <div class="absolute left-0 top-0 bottom-0 w-1 bg-[#D60000] scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
          <span class="text-xs font-['Fira_Code'] text-[#A0AEC0] group-hover:text-[#D60000]/70 transition-colors">02</span>
          PROFILE
        </a>
        <a href="/links" class="bg-white text-center w-48 md:w-56 py-6 hover:bg-[#EFEAE2] hover:text-[#D60000] transition-colors font-black text-lg md:text-xl tracking-widest flex items-center justify-center gap-3 group relative overflow-hidden">
          <!-- 装飾用のアクティブ赤線 (ホバー時に左端からスッと出現するメカニカルギミック) -->
          <div class="absolute left-0 top-0 bottom-0 w-1 bg-[#D60000] scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
          <span class="text-xs font-['Fira_Code'] text-[#A0AEC0] group-hover:text-[#D60000]/70 transition-colors">03</span>
          LINKS
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  // ハンバーガーメニューの開閉JavaScript
  const menuBtn = document.getElementById("menu-btn");
  const menuPanel = document.getElementById("menu-panel");
  const line1 = document.getElementById("line1");
  const line2 = document.getElementById("line2");
  const line3 = document.getElementById("line3");

  menuBtn?.addEventListener("click", () => {
    // パネルの表示/非表示を切り替え
    menuPanel?.classList.toggle("hidden");

    // 三本線をクロスさせるロック風アニメーション
    line1?.classList.toggle("translate-y-[7px]");
    line1?.classList.toggle("rotate-45");

    line2?.classList.toggle("opacity-0");
    line2?.classList.toggle("translate-x-2");

    line3?.classList.toggle("translate-y-[-7px]");
    line3?.classList.toggle("-rotate-45");
  });
</script>
