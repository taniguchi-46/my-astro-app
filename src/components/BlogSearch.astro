---
import type { BlogPost } from "../lib/blog";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;

const searchablePosts = posts.map((post) => {
  const pubDate =
    post.data.pubDate instanceof Date
      ? post.data.pubDate
      : new Date(post.data.pubDate);

  return {
    title: post.data.title,
    description: post.data.description,
    tags: post.data.tags,
    date: pubDate
      .toLocaleDateString("ja-JP", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      })
      .replace(/\//g, "."),
    url: `/blog/${post.id}`,
  };
});
---

<section
  class="mb-10 border-[3px] border-[#202836] bg-white p-5 md:p-6"
  aria-labelledby="blog-search-heading"
>
  <h2
    id="blog-search-heading"
    class="mb-4 font-['Fira_Code'] text-xl font-black tracking-widest text-[#202836]"
  >
    SEARCH POSTS
  </h2>
  <form class="flex flex-col gap-3 md:flex-row" data-blog-search-form>
    <label class="sr-only" for="blog-search-input">Search posts</label>
    <input
      id="blog-search-input"
      name="keyword"
      type="search"
      class="min-h-12 flex-1 border-[3px] border-[#202836] bg-[#F8FAFC] px-4 py-3 text-sm font-bold text-[#202836] outline-none placeholder:text-[#718096] focus:bg-white focus:ring-2 focus:ring-[#D60000]"
      placeholder="Search title, description, tags"
      autocomplete="off"
      data-blog-search-input
    />
    <button
      type="submit"
      class="min-h-12 border-[3px] border-[#202836] bg-[#202836] px-8 py-3 text-xs font-black tracking-widest text-white transition-colors duration-200 hover:bg-[#D60000]"
    >
      SEARCH
    </button>
  </form>
</section>

<div
  class="hidden border-[3px] border-[#202836] bg-white p-12 text-center"
  data-blog-search-empty
>
  <p class="text-lg font-bold text-[#4A5568]">
    No posts matched your search.
  </p>
</div>

<script define:vars={{ searchablePosts }}>
  function createTextElement(tagName, className, text) {
    const element = document.createElement(tagName);
    element.className = className;
    element.textContent = text;
    return element;
  }

  function createPostCard(post) {
    const card = document.createElement("section");
    card.className =
      "group relative bg-white border-[3px] border-[#202836] flex flex-col overflow-hidden hover:-translate-x-1.5 hover:-translate-y-1.5 hover:shadow-[6px_6px_0px_0px_#202836] transition-all duration-300";

    const accent = document.createElement("div");
    accent.className =
      "absolute left-0 top-0 bottom-0 w-[5px] bg-[#D60000] scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300 z-10";

    const header = document.createElement("div");
    header.className =
      "bg-[#202836] px-6 py-4 border-b-[3px] border-[#202836] flex items-center justify-between";

    header.appendChild(
      createTextElement(
        "h2",
        "font-['Fira_Code'] font-black tracking-widest text-sm md:text-base text-white",
        post.title,
      ),
    );
    header.appendChild(
      createTextElement(
        "span",
        "text-[10px] font-['Fira_Code'] text-[#A0AEC0] font-bold uppercase tracking-wider",
        post.date,
      ),
    );

    const body = document.createElement("div");
    body.className = "px-6 py-6 flex-grow";
    body.appendChild(
      createTextElement(
        "p",
        "text-sm text-[#4A5568] leading-relaxed font-medium",
        post.description,
      ),
    );

    const footer = document.createElement("div");
    footer.className =
      "px-6 py-4 bg-[#F8FAFC] border-t-2 border-[#202836] flex items-center justify-between gap-4";

    const tags = document.createElement("div");
    tags.className = "flex flex-wrap gap-1.5";
    post.tags.forEach((tag) => {
      tags.appendChild(
        createTextElement(
          "span",
          "text-[10px] font-['Fira_Code'] font-bold text-[#202836] border border-[#202836] px-2 py-0.5 uppercase tracking-wider bg-white",
          tag,
        ),
      );
    });

    const link = document.createElement("a");
    link.href = post.url;
    link.className =
      "text-xs font-bold text-[#202836] hover:text-[#D60000] transition-colors duration-200 flex items-center shrink-0";
    link.textContent = "READ MORE";

    const arrow = document.createElement("span");
    arrow.className = "ml-1 text-[#D60000] font-bold";
    arrow.textContent = ">";
    link.appendChild(arrow);

    footer.appendChild(tags);
    footer.appendChild(link);
    card.appendChild(accent);
    card.appendChild(header);
    card.appendChild(body);
    card.appendChild(footer);

    return card;
  }

  function initBlogSearch() {
    const searchForm = document.querySelector("[data-blog-search-form]");
    const searchInput = document.querySelector("[data-blog-search-input]");
    const postsHeading = document.querySelector("[data-blog-posts-heading]");
    const pageIndicator = document.querySelector("[data-blog-page-indicator]");
    const postsList = document.querySelector("[data-blog-posts-list]");
    const pagination = document.querySelector("[data-blog-pagination]");
    const emptyMessage = document.querySelector("[data-blog-search-empty]");

    if (
      !(searchForm instanceof HTMLFormElement) ||
      !(searchInput instanceof HTMLInputElement) ||
      !postsHeading ||
      !postsList ||
      !emptyMessage
    ) {
      return;
    }

    if (searchForm.dataset.blogSearchInitialized === "true") {
      return;
    }
    searchForm.dataset.blogSearchInitialized = "true";

    const initialPostCards = [...postsList.children];
    postsList.after(emptyMessage);

    function renderResults(posts) {
      postsHeading.textContent = `SEARCH RESULTS (${posts.length})`;
      postsList.replaceChildren();

      posts.forEach((post) => {
        postsList.appendChild(createPostCard(post));
      });

      emptyMessage.classList.toggle("hidden", posts.length > 0);
      postsList.classList.toggle("hidden", posts.length === 0);
      pageIndicator?.classList.add("hidden");
      pagination?.classList.add("hidden");
    }

    function resetSearch() {
      postsHeading.textContent = `ALL POSTS (${searchablePosts.length})`;
      postsList.replaceChildren(...initialPostCards);
      postsList.classList.remove("hidden");
      emptyMessage.classList.add("hidden");
      pageIndicator?.classList.remove("hidden");
      pagination?.classList.remove("hidden");
    }

    searchForm.addEventListener("submit", (event) => {
      event.preventDefault();

      const keyword = searchInput.value.trim().toLowerCase();

      if (!keyword) {
        resetSearch();
        return;
      }

      const matchedPosts = searchablePosts.filter((post) => {
        return (
          post.title.toLowerCase().includes(keyword) ||
          post.description.toLowerCase().includes(keyword) ||
          post.tags.some((tag) => tag.toLowerCase().includes(keyword))
        );
      });

      renderResults(matchedPosts);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initBlogSearch, {
      once: true,
    });
  } else {
    initBlogSearch();
  }

  document.addEventListener("astro:after-swap", initBlogSearch);
</script>
